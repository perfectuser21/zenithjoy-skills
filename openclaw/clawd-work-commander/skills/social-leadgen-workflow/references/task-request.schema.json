{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/social-leadgen-task-request-v1.json",
  "title": "Social Leadgen Task Request",
  "type": "object",
  "required": [
    "task_name",
    "tenant_id",
    "audience",
    "keywords",
    "search_policy",
    "qualification_policy",
    "comment_policy",
    "scoring_policy",
    "delivery_policy",
    "outreach_policy",
    "card_target",
    "defaults_applied"
  ],
  "properties": {
    "task_name": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "search_policy": {
      "type": "object",
      "required": [
        "sort",
        "time_layers",
        "duration",
        "scope",
        "location",
        "exhaust_visible_results"
      ],
      "properties": {
        "sort": {
          "enum": [
            "comprehensive",
            "latest",
            "most_liked",
            "most_commented",
            "most_favorited"
          ]
        },
        "time_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "one_day",
              "one_week",
              "six_months"
            ]
          }
        },
        "duration": {
          "enum": [
            "unlimited",
            "under_one_minute",
            "one_to_five_minutes",
            "over_five_minutes"
          ]
        },
        "scope": {
          "enum": [
            "unlimited",
            "following",
            "recently_viewed",
            "not_viewed"
          ]
        },
        "location": {
          "enum": [
            "unlimited",
            "same_city"
          ]
        },
        "exhaust_visible_results": {
          "type": "boolean"
        },
        "video_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "additionalProperties": false
    },
    "qualification_policy": {
      "type": "object",
      "required": [
        "transcript_coverage",
        "verdict_mode",
        "low_confidence"
      ],
      "properties": {
        "transcript_coverage": {
          "const": "full"
        },
        "verdict_mode": {
          "const": "single_full_transcript"
        },
        "low_confidence": {
          "const": "review"
        }
      },
      "additionalProperties": false
    },
    "comment_policy": {
      "type": "object",
      "required": [
        "mode",
        "window",
        "batch_size",
        "scheduler",
        "per_video_limit"
      ],
      "properties": {
        "mode": {
          "enum": [
            "visible_window_exhaustive",
            "top_n"
          ]
        },
        "window": {
          "const": "follow_video_layer"
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "scheduler": {
          "const": "round_robin"
        },
        "per_video_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "visible_window_exhaustive"
              }
            }
          },
          "then": {
            "properties": {
              "per_video_limit": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "top_n"
              }
            }
          },
          "then": {
            "properties": {
              "per_video_limit": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "scoring_policy": {
      "type": "object",
      "required": [
        "deliver_categories",
        "low_confidence"
      ],
      "properties": {
        "deliver_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "strong_intent",
              "weak_intent"
            ]
          }
        },
        "low_confidence": {
          "const": "review"
        }
      },
      "additionalProperties": false
    },
    "delivery_policy": {
      "type": "object",
      "required": [
        "destination",
        "dedupe",
        "external_outreach"
      ],
      "properties": {
        "destination": {
          "const": "tenant_final_leads"
        },
        "dedupe": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "video",
              "comment",
              "person",
              "prior_runs"
            ]
          }
        },
        "external_outreach": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "outreach_policy": {
      "type": "object",
      "required": [
        "enabled",
        "channel",
        "max_per_run",
        "claim_mode",
        "claim_key",
        "assignment_source",
        "approval_id",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "channel": {
          "const": "douyin_private_message"
        },
        "max_per_run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "claim_mode": {
          "const": "claim_then_send"
        },
        "claim_key": {
          "const": "tenant_channel_platform_user"
        },
        "assignment_source": {
          "const": "tenant_script_and_account_tables"
        },
        "approval_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "max_per_run": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "approval_id": {
                "type": "string",
                "minLength": 1
              },
              "approved_by": {
                "type": "string",
                "minLength": 1
              },
              "approved_at": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "max_per_run": {
                "const": 0
              },
              "approval_id": {
                "type": "null"
              },
              "approved_by": {
                "type": "null"
              },
              "approved_at": {
                "type": "null"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "card_target": {
      "type": "object",
      "required": [
        "audience_key",
        "chat_id",
        "visibility"
      ],
      "properties": {
        "audience_key": {
          "type": "string",
          "minLength": 1
        },
        "chat_id": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "internal",
            "external"
          ]
        }
      },
      "additionalProperties": false
    },
    "defaults_applied": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}