{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc.local/schemas/shopify-product-draft.schema.json",
  "title": "Shopify Product Experiment Draft",
  "type": "object",
  "required": [
    "object_id", "tenant_id", "market", "source_url", "human_owner", "ai_owner",
    "status", "next_action", "next_check_at", "acceptance_criteria", "updated_at",
    "economics", "compliance", "product"
  ],
  "properties": {
    "object_id": {"type": "string", "minLength": 1},
    "tenant_id": {"const": "zenithjoy"},
    "market": {"type": "string", "minLength": 2},
    "source_url": {"type": "string", "format": "uri"},
    "human_owner": {"type": "string", "minLength": 1},
    "ai_owner": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "review", "approved_for_draft", "drafted", "testing", "scaled", "stopped"]},
    "next_action": {"type": "string", "minLength": 1},
    "next_check_at": {"type": "string", "format": "date-time"},
    "acceptance_criteria": {"type": "string", "minLength": 1},
    "evidence_url": {"type": "string"},
    "updated_at": {"type": "string", "format": "date-time"},
    "economics": {
      "type": "object",
      "required": ["currency", "unit_cost", "shipping_cost", "sale_price", "payment_fee_rate", "refund_reserve_rate", "target_cpa"]
    },
    "compliance": {
      "type": "object",
      "required": ["ip_review", "product_safety_review", "claims_review", "asset_rights_review"],
      "properties": {
        "ip_review": {"enum": ["pass", "review", "fail"]},
        "product_safety_review": {"enum": ["pass", "review", "fail"]},
        "claims_review": {"enum": ["pass", "review", "fail"]},
        "asset_rights_review": {"enum": ["pass", "review", "fail"]}
      }
    },
    "product": {
      "type": "object",
      "required": ["title", "description_html", "vendor", "product_type", "tags", "variants"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description_html": {"type": "string"},
        "vendor": {"type": "string"},
        "product_type": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "options": {"type": "array"},
        "variants": {"type": "array", "minItems": 1},
        "files": {"type": "array"}
      }
    }
  }
}

