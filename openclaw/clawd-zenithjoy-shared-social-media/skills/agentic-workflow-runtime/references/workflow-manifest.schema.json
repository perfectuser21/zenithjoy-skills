{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/agentic-workflow-manifest-v2.json",
  "title": "Agentic Workflow Manifest",
  "type": "object",
  "required": ["schema_version", "workflow_id", "version", "objective", "tenant_requirements", "stages", "cleanup"],
  "anyOf": [
    { "required": ["orchestrator"] },
    { "required": ["commander"] }
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "workflow_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "version": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "dedicated_tenant": { "type": "boolean", "default": false },
    "worker_agent_id": { "type": "string", "minLength": 1 },
    "worker_agent_binding": { "const": "trusted_tenant_context.agent_id" },
    "orchestrator": { "type": "object", "required": ["type", "workflow_id", "event_protocol", "worker_may_spawn_agents"], "properties": { "type": { "const": "n8n" }, "workflow_id": { "type": "string", "minLength": 1 }, "event_protocol": { "const": "n8n-agent-node-v1" }, "worker_may_spawn_agents": { "const": false } }, "additionalProperties": true },
    "commander": { "type": "object", "required": ["agent_id", "max_parallel_stages", "event_protocol"], "properties": { "agent_id": { "const": "work-commander" }, "max_parallel_stages": { "type": "integer", "minimum": 1, "maximum": 8 }, "event_protocol": { "const": "agentic-workflow-v2" } }, "additionalProperties": true },
    "tenant_requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "stages": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "skill", "objective", "depends_on", "acceptance", "retry", "safety"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" }, "skill": { "type": "string", "minLength": 1 }, "objective": { "type": "string", "minLength": 1 }, "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "retry": { "type": "object", "required": ["max_attempts", "retry_on"], "properties": { "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 }, "retry_on": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false }, "safety": { "type": "object", "required": ["stop_on"], "properties": { "stop_on": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true } }, "additionalProperties": true } },
    "cleanup": { "type": "object", "required": ["always", "acceptance"], "properties": { "always": { "type": "boolean" }, "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } } }, "additionalProperties": true }
  },
  "additionalProperties": true
}
